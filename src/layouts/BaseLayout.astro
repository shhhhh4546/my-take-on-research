---
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href="/global.css" />
  </head>
  <body>
    <header class="wrap header">
      <a class="brand" href="/">My take on research papers</a>
      <nav class="nav">
        <a href="/">Home</a>
        <a href="/about">About</a>
      </nav>
    </header>

    <main class="wrap">
      <div class="sheet">
        <slot />
      </div>
    </main>

    <footer class="wrap footer">
      <span class="meta">Built with Astro • Hosted on Netlify</span>
    </footer>
  </body>
</html>
